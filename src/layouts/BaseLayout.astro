---
import '../styles/global.css';
import fontsCss from '../styles/fonts.css?raw';
import SiteFoot from '../components/SiteFoot.astro';
import { site, nav, ui } from 'ume/config';

const path = Astro.url.pathname;
const title = Astro.props.title ? `${Astro.props.title} · ${site.name}` : `${site.name} — ${site.motto}`;
const desc = Astro.props.description || site.description;
const origin = site.url.replace(/\/$/, '');
const canonPath = path.endsWith('/') ? path : `${path}/`;
const url = `${origin}${canonPath}`;
const rawImage = Astro.props.image || site.ogImage;
const image = rawImage
  ? (String(rawImage).startsWith('http') ? String(rawImage) : `${origin}${rawImage}`)
  : undefined;
const notesCurrent = path === '/' || path.startsWith('/page/') || path.startsWith('/notes/');
const noindex = Boolean(Astro.props.noindex);
const type = Astro.props.type || 'website';
const favicon = site.favicon || '/favicon.svg';
const rssTitle = site.rssTitle || `${site.name} — ${site.motto}`;

/**
 * Site-level display face. A site only names the families; the weight and
 * tracking that make a display face work at wordmark size come from the
 * theme, so a site can swap the face without also having to know that
 * 0.06em tracking and 700 are what the layout assumed.
 *
 * Only the keys the site actually set are emitted — an empty override must
 * leave the theme's :root completely alone, not reset it with empty values.
 */
const display = {
  family: (site.displayFont || '').trim(),
  weight:
    typeof site.displayWeight === 'number' && Number.isFinite(site.displayWeight)
      ? site.displayWeight
      : undefined,
  tracking: (site.displayTracking || '').trim(),
};
const displayCss = display.family
  ? `:root{--display:${display.family};` +
    `${display.weight !== undefined ? `--display-weight:${display.weight};` : ''}` +
    `${display.tracking ? `--display-tracking:${display.tracking};` : ''}}`
  : '';
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (function () {
        var saved = null;
        try { saved = localStorage.getItem('ume-theme'); } catch (e) {}
        var theme = saved === 'dark' || saved === 'light'
          ? saved
          : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#161616' : '#ffffff');
      })();
    </script>
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href={favicon} />
    <link rel="preload" href="/fonts/source-serif-4-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/shippori-mincho-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/zen-kaku-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <Fragment set:html={`<style>${fontsCss}</style>`} />
    {/* The one place a site can move the display role. Inlined right after
        the font stacks so it wins the cascade without needing !important and
        without touching theme internals. Empty until the site sets
        site.displayFont / displayWeight / displayTracking. */}
    {displayCss && <Fragment set:html={`<style>${displayCss}</style>`} />}
    <title>{title}</title>
    <link rel="canonical" href={url} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    {image && <meta name="twitter:image" content={image} />}
    <link rel="alternate" type="application/rss+xml" title={rssTitle} href="/rss.xml" />
  </head>
  <body>
    <!--
      THESIS: One full-bleed landscape, then a readable note stream with a right-hand thumb. Refuses a split hero, shop, player.
      OWN-WORLD: #fff / #00865b / #333. Mincho titles, gothic body.
      STORY: Arrive in one picture, then read. Nav is notes / archive / about / rss.
      FIRST VIEWPORT: White mast, one landscape, title and lede on it.
      FORM: ume green + a single reading column. Not a halved magazine.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <div class="shell">
      <header class="mast">
        <div class="wrap mast-row mast-desk">
          <a class="wordmark" href="/">{site.wordmark}</a>
          <nav class="topnav" aria-label={ui.ariaNav}>
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  item.href === '/'
                    ? notesCurrent ? 'page' : undefined
                    : item.href !== '/rss.xml' && path.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined
                }
              >{item.label}</a>
            ))}
          </nav>
          <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to night">
            <span class="theme-opt" data-day>Day</span><span class="theme-bar" aria-hidden="true"></span><span class="theme-opt" data-night>Night</span>
          </button>
        </div>
        <div class="wrap mast-phone">
          <div class="mast-brand">
            <a class="wordmark" href="/">{site.wordmark}</a>
            <button class="menu-btn" type="button" data-menu-open aria-expanded="false" aria-controls="site-drawer" aria-label="Open menu">
              <span class="menu-bars" aria-hidden="true"></span>
            </button>
            <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label="Switch to night">
            <span class="theme-opt" data-day>Day</span><span class="theme-bar" aria-hidden="true"></span><span class="theme-opt" data-night>Night</span>
          </button>
          </div>
        </div>
        <div class="drawer" id="site-drawer" hidden>
          <button class="drawer-veil" type="button" data-menu-close tabindex="-1" aria-label="Close menu"></button>
          <nav class="drawer-panel" aria-label={ui.ariaNav}>
            <button class="drawer-close" type="button" data-menu-close aria-label="Close menu">Close</button>
            {nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  item.href === '/'
                    ? notesCurrent ? 'page' : undefined
                    : item.href !== '/rss.xml' && path.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined
                }
              >{item.label}</a>
            ))}
          </nav>
        </div>
      </header>
      <main id="main">
        <slot />
      </main>
      <SiteFoot />
    </div>
  <script is:inline>
  (function () {
    var btns = document.querySelectorAll('[data-theme-toggle]');
    if (!btns.length) return;
    function paint() {
      var dark = document.documentElement.dataset.theme === 'dark';
      btns.forEach(function (btn) {
        btn.setAttribute('aria-pressed', String(dark));
        btn.setAttribute('aria-label', dark ? 'Switch to day' : 'Switch to night');
      });
    }
    paint();
    btns.forEach(function (btn) { btn.addEventListener('click', function () {
      var dark = document.documentElement.dataset.theme !== 'dark';
      if (dark) document.documentElement.dataset.theme = 'dark';
      else delete document.documentElement.dataset.theme;
      try { localStorage.setItem('ume-theme', dark ? 'dark' : 'light'); } catch (e) {}
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', dark ? '#161616' : '#ffffff');
      paint();
    }); });
  })();
  </script>
  <script is:inline>
  (function () {
    var drawer = document.getElementById('site-drawer');
    var openBtn = document.querySelector('[data-menu-open]');
    if (!drawer || !openBtn) return;
    function set(open) {
      drawer.hidden = !open;
      openBtn.setAttribute('aria-expanded', String(open));
      openBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.documentElement.classList.toggle('menu-open', open);
    }
    openBtn.addEventListener('click', function () { set(drawer.hidden); });
    drawer.querySelectorAll('[data-menu-close]').forEach(function (el) {
      el.addEventListener('click', function () { set(false); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !drawer.hidden) set(false);
    });
  })();
  </script>
  </body>
</html>
