---
import BaseLayout from '../layouts/BaseLayout.astro';
import IssueHead from '../components/IssueHead.astro';
import { about, site, ui } from 'lone/config';

const body = about.body ?? [];
const quote = about.quote ?? '';
const stack = about.stack ?? [];
---
<BaseLayout title={about.title} description={about.lede}>
  <div class="page about-page">
    <IssueHead title={about.title} lede={about.lede} />
    {body.length > 0 && (
      <div class="prose about-letter">
        {body.map((p) => <p>{p}</p>)}
      </div>
    )}
    {quote && <blockquote class="about-quote">{quote}</blockquote>}
    {stack.length > 0 && (
      <dl class="about-stack">
        {stack.map((g) => (
          <div class="about-stack-row">
            <dt>{g.label}</dt>
            <dd>
              {g.items.map((t, i) => (
                <>
                  {i > 0 && <span class="about-sep" aria-hidden="true"> · </span>}
                  <span>{t}</span>
                </>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    )}
    <p class="about-links">
      {site.email && <a href={`mailto:${site.email}`}>{ui.linkEmail}</a>}
      {site.github && <a href={site.github}>{ui.linkGithub}</a>}
      <a href="/rss.xml">{ui.linkRss}</a>
      <a href="/archive/">{ui.allNotes}</a>
    </p>
  </div>
</BaseLayout>
