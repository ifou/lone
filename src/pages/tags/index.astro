---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueHead from '../../components/IssueHead.astro';
import TagFlow from '../../components/TagFlow.astro';
import { tags as tagsCopy, ui } from 'lone/config';
import { published, tagsOf } from '../../lib/posts';

const tags = tagsOf(await published());
---
<BaseLayout title={tagsCopy.title} description={tagsCopy.lede}>
  <div class="page">
    <IssueHead title={tagsCopy.title} lede={tagsCopy.lede} />
    {tags.length === 0
      ? <p class="empty">{ui.emptyTags}</p>
      : <TagFlow tags={tags} />}
  </div>
</BaseLayout>
