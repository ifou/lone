---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueHead from '../../components/IssueHead.astro';
import NoteStream from '../../components/NoteStream.astro';
import { tags as tagsCopy, ui } from 'plum/config';
import { published, tagsOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await published();
  return tagsOf(posts).map(({ tag }) => ({ params: { tag } }));
}

const all = await published();
const tag = decodeURIComponent(Astro.params.tag ?? '');
const posts = all.filter((p) => (p.data.tags ?? []).some((t) => t.trim() === tag));
---
<BaseLayout title={tag} description={`${tagsCopy.title}: ${tag}`}>
  <div class="wrap">
    <section class="news">
      <IssueHead
        title={tag}
        lede={ui.noteCount(posts.length)}
        tagged
        backHref="/tags/"
        backLabel={ui.backToTags}
      />
      {posts.length === 0
        ? <p class="empty">{ui.emptyStream}</p>
        : <NoteStream posts={posts} />}
    </section>
  </div>
</BaseLayout>
