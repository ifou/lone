---
import BaseLayout from '../layouts/BaseLayout.astro';
import IssueHead from '../components/IssueHead.astro';
import { notFound, ui } from 'plum/config';
import { published, hrefOf, opening } from '../lib/posts';

const newest = (await published())[0] ?? null;
---
<BaseLayout title={notFound.title} description={notFound.lede} noindex>
  <div class="page">
    <article class="note">
      <IssueHead title={notFound.title} lede={notFound.lede} />
      {newest && (
        <p class="lost-note">
          <a href={hrefOf(newest)}>
            <small>{ui.leadLabel}</small>
            {newest.data.title}
          </a>
          <span>{opening(newest, 180)}</span>
        </p>
      )}
    </article>
  </div>
</BaseLayout>
