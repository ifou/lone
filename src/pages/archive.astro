---
import BaseLayout from '../layouts/BaseLayout.astro';
import IssueHead from '../components/IssueHead.astro';
import { archive, categories as catsCopy, tags, ui } from 'plum/config';
import { published, hrefOf, formatDate, yearGroups } from '../lib/posts';

const groups = yearGroups(await published());
---
<BaseLayout title={archive.title} description={archive.lede}>
  <div class="page">
    <IssueHead title={archive.title} lede={archive.lede}>
      <p class="about-links">
        <a href="/categories/">{catsCopy.title}</a>
        <a href="/tags/">{tags.title}</a>
      </p>
    </IssueHead>
    {groups.length === 0
      ? <p class="empty">{ui.emptyStream}</p>
      : groups.map(({ year, posts }) => (
        <section class="year-block">
          <h2 class="year-title">{year}<span class="book-count">{posts.length}</span></h2>
          <ol class="year-list">
            {posts.map((p) => (
              <li>
                <a href={hrefOf(p)}>
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <span lang={p.data.lang || undefined}>{p.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
  </div>
</BaseLayout>
