---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import { published, slugOf, type Post } from '../../lib/posts';

const all = await published();

export async function getStaticPaths() {
  const posts = await published();
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const i = all.findIndex((p) => p.id === post.id);
const newer = i > 0 ? all[i - 1] : null;
const older = i < all.length - 1 ? all[i + 1] : null;
---
<BaseLayout title={post.data.title} description={post.data.description} type="article" image={post.data.cover || post.data.images?.[0] || ''}>
  <PostArticle post={post} older={older} newer={newer} />
</BaseLayout>
