---
import BaseLayout from '../layouts/BaseLayout.astro';
import IssueHead from '../components/IssueHead.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { poems as poemsCopy, ui } from 'plum/config';
import { formatDate } from '../lib/posts';

type Poem = CollectionEntry<'poems'>;

const all = (await getCollection('poems'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// group into books by year, newest first
const books = new Map<number, Poem[]>();
for (const p of all) {
  const y = p.data.date.getUTCFullYear();
  const list = books.get(y) ?? [];
  list.push(p);
  books.set(y, list);
}
const groups = [...books.entries()].sort((a, b) => b[0] - a[0]);

function verseOf(p: Poem) {
  return (p.body ?? '').replace(/^\n+/, '').replace(/\n+$/, '');
}

---
<BaseLayout title={poemsCopy.title} description={poemsCopy.lede} noindex>
  <div class="page page-wide">
    <IssueHead title={poemsCopy.title} lede={poemsCopy.lede} />

    {groups.length === 0 ? (
      <p class="empty">{ui.emptyPoems}</p>
    ) : (
      <>
        <nav class="book-index" aria-label={ui.ariaYears}>
          {groups.map(([year, poems], gi) => (
            <a href={`#y${year}`}>
              <span class="book-index-num">{groups.length - gi}</span>
              {year}<i>{poems.length}</i>
            </a>
          ))}
        </nav>

        {groups.map(([year, poems], gi) => (
          <section class="poem-book" id={`y${year}`}>
            <h2 class="book-title">
              <span class="book-num">{ui.bookLabel(String(groups.length - gi))}</span>
              {year}
              <span class="book-count">{ui.poemCount(poems.length)}</span>
            </h2>
            <div class="book-grid">
              {poems.map((p) => (
                <article class="poem">
                  <h3 class="poem-title" lang={p.data.lang || undefined}>{p.data.title}</h3>
                  <time class="poem-date" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <pre class="poem-body" lang={p.data.lang || undefined}>{verseOf(p)}</pre>
                </article>
              ))}
            </div>
          </section>
        ))}
      </>
    )}
  </div>
</BaseLayout>
