---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHead from '../components/HomeHead.astro';
import NoteStream from '../components/NoteStream.astro';
import Pager from '../components/Pager.astro';
import HomeBrowse from '../components/HomeBrowse.astro';
import { home, ui } from 'plum/config';
import { published, pageSizeOf, pageCount, pageOf, streamOf, leadOf } from '../lib/posts';

const posts = await published();
const stream = streamOf(posts, leadOf(posts, home.pin));
const size = pageSizeOf(home.pageSize);
const pages = pageCount(stream.length, size);
const slice = pageOf(stream, 1, size);
const heroSrc = home.hero || '/images/hero.jpg';
---
<BaseLayout image={heroSrc}>
  <HomeHead posts={posts} />

  <div class="wrap">
    <section class="news">
      <h2 class="block-title">{home.streamLabel}</h2>
      {slice.length === 0
        ? <p class="empty">{ui.emptyStream}</p>
        : <NoteStream posts={slice} eager />}
      <Pager page={1} pages={pages} />
    </section>
    <HomeBrowse />
  </div>
</BaseLayout>
