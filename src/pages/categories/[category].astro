---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IssueHead from '../../components/IssueHead.astro';
import NoteStream from '../../components/NoteStream.astro';
import { categories as catsCopy, ui } from 'plum/config';
import { published, byCategory, categoryOf } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await published();
  return byCategory(posts).map(({ category }) => ({ params: { category } }));
}

const all = await published();
const category = Astro.params.category ?? '';
const posts = all.filter((p) => categoryOf(p) === category);
const label = catsCopy.labels[category] || category;
---
<BaseLayout title={label} description={`${catsCopy.title}: ${label}`}>
  <div class="wrap">
    <section class="news">
      <IssueHead
        title={label}
        lede={ui.noteCount(posts.length)}
        backHref="/"
        backLabel={ui.backToNotes}
      />
      {posts.length === 0
        ? <p class="empty">{ui.emptyStream}</p>
        : <NoteStream posts={posts} />}
    </section>
  </div>
</BaseLayout>
