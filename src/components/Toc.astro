---
import { ui } from 'ume/config';

type Heading = { depth: number; slug: string; text: string };

const { headings = [] } = Astro.props as { headings: Heading[] };

const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
let h2Seen = 0;
const tocNums = new Map<string, string>();
for (const h of toc) {
  if (h.depth === 2) {
    h2Seen += 1;
    tocNums.set(h.slug, String(h2Seen));
  }
}
const tocTop = h2Seen > 0 ? 2 : 3;
const label = ui.tocLabel || ui.ariaContents;
---
{toc.length >= 2 && (
  <nav class="toc" aria-labelledby="toc-label">
    <p class="toc-label" id="toc-label">{label}</p>
    <ol>
      {toc.map((h) => (
        <li class={h.depth > tocTop ? 'is-h3' : undefined}>
          {tocNums.has(h.slug) && <span class="toc-num">{tocNums.get(h.slug)}</span>}
          <a href={`#${h.slug}`}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
