---
import { categories as catsCopy, ui } from 'lone/config';
import { hrefOf, utcYmd, opening, galleryOf, categoryOf, langOf, readMinutes, type Post } from '../lib/posts';
import { measureAll, srcsetOf } from '../lib/images';

const { posts, eager = false } = Astro.props as {
  posts: Post[];
  eager?: boolean;
};

const TILES = 3;

const sized = await measureAll(posts.flatMap((p) => galleryOf(p).slice(0, TILES)));
const labels = catsCopy.labels;
---

<ol class="stream">
  {posts.map((p, i) => {
    const ymd = utcYmd(p.data.date);
    const shots = galleryOf(p);
    const tiles = shots.slice(0, TILES);
    const more = Math.max(0, shots.length - tiles.length);
    const n = tiles.length;
    const kind = labels[categoryOf(p)] || '';
    const lang = langOf(p);
    const mins = readMinutes(p);
    const photos = shots.length;
    return (
      <li>
        <a class={`row${n ? ` has-thumb is-${n}` : ' no-thumb'}`} href={hrefOf(p)}>
          <time class="row-date" datetime={p.data.date.toISOString()}>
            <b>{ymd.day}</b>
            <i>{ymd.y}/{ymd.m}</i>
          </time>
          <span class="row-text">
            <h3 class="entry-title" lang={p.data.lang || undefined}>{p.data.title}</h3>
            <p class="entry-open">{opening(p, n ? 140 : 180)}</p>
            <span class="row-facts">
              {kind && <span class="is-kind">{kind}</span>}
              <span>{ui.readMin(mins)}</span>
              {photos > 0 && <span>{ui.photoCount(photos)}</span>}
              {lang === 'en' && <span>{ui.langEn}</span>}
              {lang === 'zh' && <span>{ui.langZh}</span>}
            </span>
          </span>
          {n > 0 && (
            <span class={`row-mosaic is-${n}`}>
              {tiles.map((src, j) => {
                const s = sized[src];
                return (
                  <span class={j === 0 ? 'is-vert' : 'is-wide'}>
                    <img
                      src={src}
                      srcset={srcsetOf(src)}
                      sizes="(max-width: 639px) 46vw, 200px"
                      alt=""
                      width={s?.width || (j === 0 ? 240 : 320)}
                      height={s?.height || (j === 0 ? 320 : 200)}
                      loading={eager && i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    {j === n - 1 && more > 0 && (
                      <span class="row-more" aria-label={ui.morePhotos(more)}>{ui.morePhotos(more)}</span>
                    )}
                  </span>
                );
              })}
            </span>
          )}
        </a>
      </li>
    );
  })}
</ol>
