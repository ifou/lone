---
const {
  title,
  lede = '',
  eyebrow = '',
  backHref = '',
  backLabel = '',
  lang = '',
  tagged = false,
} = Astro.props as {
  title: string;
  lede?: string;
  eyebrow?: string;
  backHref?: string;
  backLabel?: string;
  lang?: string;
  tagged?: boolean;
};
---
<header class={`issue-head${tagged ? ' is-tag' : ''}`}>
  {backHref && backLabel && <a class="back" href={backHref}>{backLabel}</a>}
  {eyebrow && <p class="issue-kicker">{eyebrow}</p>}
  <h1 class="note-title" lang={lang || undefined}>{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
