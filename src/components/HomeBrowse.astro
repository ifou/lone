---
import { categories as catsCopy, home, ui } from 'plum/config';
import TagFlow from './TagFlow.astro';
import { published, byCategory, categoryHref, tagsOf } from '../lib/posts';

const posts = await published();
const shelves = byCategory(posts);
const all = tagsOf(posts);
const limit = home.tagPreview ?? 6;
const tags = [...all]
  .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, 'en'))
  .slice(0, limit);
const labels = catsCopy.labels;
---

{(shelves.length > 0 || tags.length > 0) && (
  <section class="browse">
    {tags.length > 0 && (
      <div class="browse-col">
        <h2 class="browse-head">{ui.bySubject}</h2>
        <TagFlow tags={tags} />
        {all.length > tags.length && (
          <p class="tag-more">
            <a href="/tags/">{ui.allTagsCount(all.length)}</a>
          </p>
        )}
      </div>
    )}
    {shelves.length > 0 && (
      <div class="browse-col">
        <h2 class="browse-head">{ui.byKind}</h2>
        <ul class="shelf">
          {shelves.map(({ category, posts: items }) => (
            <li>
              <a href={categoryHref(category)}>
                <span>{labels[category] || category}</span>
                <i>{items.length}</i>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
)}
