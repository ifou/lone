---
import { ui } from 'plum/config';
import { pageHref } from '../lib/posts';

const { page, pages } = Astro.props as { page: number; pages: number };
const nums = Array.from({ length: pages }, (_, i) => i + 1);
const prev = page > 1 ? page - 1 : 0;
const next = page < pages ? page + 1 : 0;
---
{pages > 1 && (
  <nav class="pager" aria-label={ui.ariaPager}>
    {prev
      ? (
        <a class="pager-dir" href={pageHref(prev)} rel="prev" aria-label={ui.pagerPrev}>
          <svg class="pager-ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M10.2 3.2 5.4 8l4.8 4.8" />
          </svg>
        </a>
      )
      : (
        <span class="pager-dir is-off" aria-hidden="true">
          <svg class="pager-ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M10.2 3.2 5.4 8l4.8 4.8" />
          </svg>
        </span>
      )}
    <ol class="pager-list">
      {nums.map((n) => (
        <li>
          {n === page
            ? <span class="pager-n is-now" aria-current="page">{n}</span>
            : <a class="pager-n" href={pageHref(n)} aria-label={ui.pagerPage(n)}>{n}</a>}
        </li>
      ))}
    </ol>
    {next
      ? (
        <a class="pager-dir" href={pageHref(next)} rel="next" aria-label={ui.pagerNext}>
          <svg class="pager-ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M5.8 3.2 10.6 8 5.8 12.8" />
          </svg>
        </a>
      )
      : (
        <span class="pager-dir is-off" aria-hidden="true">
          <svg class="pager-ico" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M5.8 3.2 10.6 8 5.8 12.8" />
          </svg>
        </span>
      )}
  </nav>
)}
