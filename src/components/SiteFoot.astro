---
import { site, ui } from 'ume/config';

const themeName = ui.footTheme || 'ume';
---

<footer class="site-foot">
  <div class="wrap foot-inner">
    <div class="foot-brand">
      <a class="foot-mark" href="/">{site.wordmark}</a>
      {site.motto && <p class="foot-motto">{site.motto}</p>}
    </div>
    <div class="foot-colophon">
      <p class="foot-copy">{ui.footCopyright(site.years, site.wordmark)}</p>
      <p class="foot-theme">
        {ui.footThemeLabel && <span class="foot-theme-lab">{ui.footThemeLabel}</span>}
        {ui.footThemeHref
          ? <a href={ui.footThemeHref}>{themeName}</a>
          : <span class="foot-theme-name">{themeName}</span>}
      </p>
    </div>
  </div>
</footer>
