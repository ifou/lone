---
import { render } from 'astro:content';
import { categories as catsCopy, ui } from 'plum/config';
import { hrefOf, formatDate, tagHref, galleryOf, categoryOf, langOf, readMinutes, type Post } from '../lib/posts';
import { srcsetOf, measure } from '../lib/images';
import Gallery from './Gallery.astro';

const { post, older, newer } = Astro.props as {
  post: Post;
  older: Post | null;
  newer: Post | null;
};

const { Content, headings } = await render(post);
const shots = galleryOf(post);
const cover = shots[0] || '';
const gallery = cover ? shots.slice(1) : shots;
const tags = (post.data.tags ?? []).map((t) => t.trim()).filter(Boolean);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const hasBody = Boolean((post.body ?? '').trim());
const kind = catsCopy.labels[categoryOf(post)] || '';
const lang = langOf(post);
const mins = readMinutes(post);
const photos = shots.length;
const coverSize = cover ? await measure(cover) : { width: 1920, height: 1280 };

let h2Seen = 0;
const tocNums = new Map<string, string>();
for (const h of toc) {
  if (h.depth === 2) { h2Seen += 1; tocNums.set(h.slug, String(h2Seen)); }
}
const tocTop = h2Seen > 0 ? 2 : 3;
---

<article class="note" lang={post.data.lang || undefined}>
  <header class={`cover-hero${cover ? "" : " is-type"}`}>
    {cover && <img src={cover} srcset={srcsetOf(cover)} sizes="(max-width: 639px) 100vw, 900px" alt="" width={coverSize.width || 1920} height={coverSize.height || 1280} fetchpriority="high" decoding="async" />}
    {cover && <div class="cover-scrim" aria-hidden="true"></div>}
    <div class="cover-copy">
      <a class="back is-on-photo" href="/">{ui.backToNotes}</a>
      <time class="meta" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <h1 class="note-title" lang={post.data.lang || undefined}>{post.data.title}</h1>
    </div>
  </header>
  <div class="page">
    {post.data.description && <p class="lede">{post.data.description}</p>}
    <p class="note-facts">
      {kind && <span class="is-kind">{kind}</span>}
      <span>{ui.readMin(mins)}</span>
      {photos > 0 && <span>{ui.photoCount(photos)}</span>}
      {lang === 'en' && <span>{ui.langEn}</span>}
      {lang === 'zh' && <span>{ui.langZh}</span>}
    </p>
    {tags.length > 0 && (
      <ul class="note-tags">
        {tags.map((t) => (
          <li><a href={tagHref(t)}>{t}</a></li>
        ))}
      </ul>
    )}
    {toc.length >= 2 && (
      <nav class="toc" aria-label={ui.ariaContents}>
        <ol>
          {toc.map((h) => (
            <li class={h.depth > tocTop ? 'is-h3' : undefined}>
              {tocNums.has(h.slug) && <span class="toc-num">{tocNums.get(h.slug)}</span>}
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    {hasBody && <div class="prose"><Content /></div>}
    {gallery.length > 0 && <Gallery images={gallery} />}
    <nav class="post-nav" aria-label={ui.ariaAdjacent}>
      <div class="post-nav-adj">
        {older
          ? <a href={hrefOf(older)}><small>{ui.postNavOlder}</small>{older.data.title}</a>
          : <span></span>}
        {newer
          ? <a class="is-newer" href={hrefOf(newer)}><small>{ui.postNavNewer}</small>{newer.data.title}</a>
          : <span></span>}
      </div>
      <a class="post-nav-all" href="/archive/"><small>{ui.postNavAll}</small>{ui.allNotes}</a>
    </nav>
  </div>
</article>
