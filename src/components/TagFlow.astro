---
import { tagHref } from '../lib/posts';

const { tags } = Astro.props as { tags: { tag: string; count?: number }[] };
---
<ul class="tag-flow">
  {tags.map(({ tag, count }) => (
    <li>
      <a href={tagHref(tag)} title={count && count > 1 ? `${count} notes` : undefined}>
        {tag}
        {count !== undefined && count > 1 && <span class="tag-count">{count}</span>}
      </a>
    </li>
  ))}
</ul>
