---
import { categories as catsCopy, home, site, ui } from 'ume/config';
import { hrefOf, formatDate, opening, coverOf, galleryOf, categoryOf, langOf, readMinutes, leadOf, slugOf, type Post } from '../lib/posts';
import { srcsetOf, measure } from '../lib/images';

const { posts } = Astro.props as { posts: Post[] };
const pin = (home.pin || '').trim();
const lead = leadOf(posts, pin);
const isPinned = Boolean(pin && lead && slugOf(lead) === pin);
const leadLabel = isPinned ? ui.pinLabel : ui.leadLabel;
const leadThumb = lead ? coverOf(lead) : '';
const heroSrc = home.hero || '/images/hero.jpg';
const heroSize = await measure(heroSrc);
const issueYear = lead ? lead.data.date.getUTCFullYear() : new Date().getUTCFullYear();
const leadKind = lead ? (catsCopy.labels[categoryOf(lead)] || '') : '';
const leadLang = lead ? langOf(lead) : '';
const leadMins = lead ? readMinutes(lead) : 0;
const leadPhotos = lead ? galleryOf(lead).length : 0;
---

<section class="hero">
  <img
    src={heroSrc}
    srcset={srcsetOf(heroSrc)}
    sizes="100vw"
    alt=""
    width={heroSize.width || 1920}
    height={heroSize.height || 1280}
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-scrim" aria-hidden="true"></div>
  <div class="wrap hero-copy">
    <p class="hero-issue">{ui.issueMeta(issueYear, posts.length)}</p>
    <h1 class="hero-title">{home.title || site.wordmark}</h1>
    {home.lede && <p class="hero-lede">{home.lede}</p>}
  </div>
</section>

{lead && (
  <div class="wrap">
    <section class="lead-note" aria-label={leadLabel}>
      <a class={`lead${leadThumb ? '' : ' no-thumb'}`} href={hrefOf(lead)}>
        <span class="lead-left">
          <span class="lead-eyebrow">{leadLabel}</span>
          <span class="lead-date"><time datetime={lead.data.date.toISOString()}>{formatDate(lead.data.date)}</time></span>
        </span>
        <span class="lead-body">
          <h2 class="lead-title" lang={lead.data.lang || undefined}>{lead.data.title}</h2>
          <p class="lead-open">{opening(lead, 180)}</p>
          <span class="lead-facts">
            {leadKind && <span class="is-kind">{leadKind}</span>}
            <span>{ui.readMin(leadMins)}</span>
            {leadPhotos > 0 && <span>{ui.photoCount(leadPhotos)}</span>}
            {leadLang === 'en' && <span>{ui.langEn}</span>}
            {leadLang === 'zh' && <span>{ui.langZh}</span>}
          </span>
          <span class="lead-read">{ui.leadRead}</span>
        </span>
        {leadThumb && (
          <span class="lead-thumb">
            <img src={leadThumb} srcset={srcsetOf(leadThumb)} sizes="(max-width: 639px) 100vw, 176px" alt="" width="416" height="520" loading="eager" decoding="async" />
          </span>
        )}
      </a>
    </section>
  </div>
)}
